{{!-- src/views/index.handlebars --}}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="text-center">
        {{!-- Logo/Título --}}
        <div class="mb-5">
            <h1 class="display-4 mb-4">🛒 E-Commerce Backend</h1>
            <p class="lead text-muted mb-5">Sistema de gestión de productos</p>
        </div>

        {{!-- Opciones de ingreso --}}
        <div class="row g-4 justify-content-center">

            {{!-- OPCIÓN 1: CLIENTE --}}
            <div class="col-md-5">
                <div class="card shadow-lg h-100 border-primary hover-card">
                    <div class="card-body p-5 text-center">
                        <div class="mb-4">
                            <i class="bi bi-person-circle text-primary" style="font-size: 5rem;"></i>
                        </div>
                        <h3 class="card-title mb-3">Soy Cliente</h3>
                        <p class="text-muted mb-4">
                            Explora nuestro catálogo de productos y realiza tus compras
                        </p>
                        <a href="/products" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-bag"></i> Ver Catálogo
                        </a>
                    </div>
                </div>
            </div>

            {{!-- OPCIÓN 2: ADMINISTRADOR --}}
            <div class="col-md-5">
                <div class="card shadow-lg h-100 border-success hover-card">
                    <div class="card-body p-5 text-center">
                        <div class="mb-4">
                            <i class="bi bi-shield-lock text-success" style="font-size: 5rem;"></i>
                        </div>
                        <h3 class="card-title mb-3">Soy Administrador</h3>
                        <p class="text-muted mb-4">
                            Gestiona productos en tiempo real con actualizaciones instantáneas
                        </p>
                        <a href="/realtimeproducts" class="btn btn-success btn-lg w-100">
                            <i class="bi bi-lightning-charge"></i> Gestionar Productos
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {{!-- Información adicional --}}
        <div class="mt-5">
            <p class="text-muted">
                <small>Proyecto Backend I - Sistema de E-commerce</small>
            </p>
        </div>
    </div>
</div>

{{!-- Estilos --}}
<style>
    body,
    .bg-light {
        background-color: #f8f9fa !important;
    }

    .mt-4 {
        margin-top: 0rem !important;
    }

    .hover-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }

    .hover-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2) !important;
    }

    .min-vh-100 {
        min-height: 100vh;
    }
</style>

