{{!-- Navbar --}}
<nav class="navbar navbar-expand-lg navbar-dark sticky-top shadow">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="/">
            <i class="bi bi-shop"></i> E-Commerce Backend
        </a>
        <div class="navbar-nav ms-auto">
            <a class="nav-link" href="/">Inicio</a>
            <a class="nav-link" href="/products">Productos</a>
            <a class="nav-link position-relative" href="#" id="cart-link">
                <i class="bi bi-cart3"></i> Mi Carrito
                <span class="badge bg-danger rounded-pill position-absolute top-0 start-100 translate-middle"
                    id="cart-badge">0</span>
            </a>
        </div>
    </div>
</nav>

<div class="container-fluid mt-3">
    <nav>
        <ol class="breadcrumb justify-content-center mb-0">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="/products">Productos</a></li>
            <li class="breadcrumb-item active">{{product.title}}</li>
        </ol>
    </nav>
</div>

{{!-- Detalle del Producto --}}
<div class="container-fluid my-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-5">
                            <div class="position-relative{{#if (eq product.stock 0)}} out-of-stock{{/if}}">
                                {{#if product.thumbnails.[0]}}
                                <img src="{{product.thumbnails.[0]}}" class="img-fluid rounded shadow-sm"
                                    alt="{{product.title}}" style="width: 100%; object-fit: cover; height: 28.6rem;">
                                {{else}}
                                <div class="bg-secondary d-flex align-items-center justify-content-center rounded"
                                    style="height: 400px;">
                                    <i class="bi bi-image text-white" style="font-size: 5rem;"></i>
                                </div>
                                {{/if}}

                                {{#if (eq product.stock 0)}}
                                <div class="position-absolute bottom-0 start-0 w-100 text-center">
                                    <div
                                        style="background: rgba(0,0,0,0.85); color: #fff; padding: 0.8rem 0; font-weight: bold; font-size: 1.1rem;">
                                        SIN STOCK
                                    </div>
                                </div>
                                {{/if}}
                            </div>
                        </div>

                        <div class="col-md-7">
                            <h1 class="fw-bold text-uppercase mb-3" style="font-size: 2rem; color: #000;">
                                {{product.title}}
                            </h1>

                            <p class="text-muted mb-4">
                                {{product.description}}
                            </p>
                            <hr>
                            <div class="mb-4">
                                <h2 class="product-price mb-0">
                                    ${{product.price}}
                                </h2>
                            </div>
                            <hr>
                            <div class="mb-4">
                                <div class="d-flex align-items-center flex-row"
                                    style="gap:1rem; flex-wrap: nowrap; overflow-x: auto;">
                                    <div class="me-3 mb-0">
                                        <strong>Categoría:</strong>
                                        <span class="badge bg-secondary">{{product.category}}</span>
                                    </div>
                                    <div class="me-3 mb-0">
                                        <strong>Código:</strong>
                                        <span class="text-muted">{{product.code}}</span>
                                    </div>
                                    <div class="me-3 mb-0">
                                        {{#if (gt product.stock 0)}}
                                        <span class="badge bg-success"><strong>En Stock</strong></span>
                                        {{else}}
                                        <span class="badge bg-danger">Agotado</span>
                                        {{/if}}
                                    </div>
                                </div>
                            </div>
                            <hr>
                            {{#if (gt product.stock 0)}}
                            <div class="mb-4">
                                <label class="fw-bold mb-2">Cantidad:</label>
                                <div class="btn-group w-100" style="max-width: 160px;">
                                    <button class="btn btn-lg" type="button" id="decreaseBtn">
                                        <i class="bi bi-dash-lg"></i>
                                    </button>
                                    <input type="text" class="form-control form-control-lg text-center fw-bold"
                                        id="quantityInput" value="1" readonly>
                                    <button class="btn btn-lg" type="button" id="increaseBtn">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="d-grid gap-2 mb-3">
                                <button class="btn btn-lg" id="addToCartBtn" data-id="{{product._id}}"
                                    style="padding: 0.8rem;">
                                    <i class="bi bi-cart-plus"></i> Agregar al Carrito
                                </button>
                            </div>
                            {{else}}
                            <div class="alert alert-warning mb-3">
                                <i class="bi bi-exclamation-triangle"></i> Este producto no está disponible
                            </div>
                            {{/if}}

                            <div class="d-grid gap-2">
                                <a href="/products" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left"></i> Volver al Catálogo
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{!-- JavaScript --}}
<script>
    const productId = '{{product._id}}'
    const maxStock = {{ product.stock }}
    const quantityInput = document.getElementById('quantityInput')
    const decreaseBtn = document.getElementById('decreaseBtn')
    const increaseBtn = document.getElementById('increaseBtn')
    const addToCartBtn = document.getElementById('addToCartBtn')
    let productInCart = false

    // Función para crear o recuperar el carrito
    function ensureCart(callback) {
        const cartId = localStorage.getItem('cartId')

        if (!cartId) {
            // Crear nuevo carrito
            fetch('/api/carts', { method: 'POST' })
                .then(function (res) { return res.json() })
                .then(function (data) {
                    const newCartId = data.carrito._id
                    localStorage.setItem('cartId', newCartId)
                    callback(newCartId)
                })
        } else {
            callback(cartId)
        }
    }

    // Actualizar el enlace del carrito
    function updateCartLink() {
        const cartId = localStorage.getItem('cartId')
        const cartLink = document.getElementById('cart-link')

        if (cartId) {
            cartLink.href = '/carts/' + cartId
        } else {
            cartLink.href = '#'
        }
    }

    function updateCartBadge() {
        const cartId = localStorage.getItem('cartId')
        if (!cartId) {
            document.getElementById('cart-badge').textContent = '0'
            if (addToCartBtn) {
                addToCartBtn.innerHTML = '<i class="bi bi-cart-plus"></i> Agregar al Carrito'
            }
            updateCartLink()
            return
        }

        fetch('/api/carts/' + cartId)
            .then(function (response) {
                if (!response.ok) {
                    // Si el carrito no existe, crear uno nuevo
                    localStorage.removeItem('cartId')
                    ensureCart(function (newCartId) {
                        updateCartBadge()
                    })
                    return null
                }
                return response.json()
            })
            .then(function (cart) {
                if (!cart) return

                if (cart.error || cart.status === 'error') {
                    // Si hay error, limpiar localStorage
                    localStorage.removeItem('cartId')
                    document.getElementById('cart-badge').textContent = '0'
                    if (addToCartBtn) {
                        addToCartBtn.innerHTML = '<i class="bi bi-cart-plus"></i> Agregar al Carrito'
                    }
                    updateCartLink()
                    return
                }

                let total = 0
                productInCart = false

                for (let i = 0; i < cart.products.length; i++) {
                    total = total + cart.products[i].quantity

                    const cartProductId = cart.products[i].product._id || cart.products[i].product
                    if (cartProductId === productId && quantityInput) {
                        quantityInput.value = cart.products[i].quantity
                        productInCart = true
                    }
                }

                document.getElementById('cart-badge').textContent = total

                if (addToCartBtn) {
                    if (productInCart) {
                        addToCartBtn.innerHTML = '<i class="bi bi-cart-check"></i> Actualizar Carrito'
                    } else {
                        addToCartBtn.innerHTML = '<i class="bi bi-cart-plus"></i> Agregar al Carrito'
                    }
                }
                updateCartLink()
            })
            .catch(function (error) {
                console.error('Error al actualizar badge:', error)
                document.getElementById('cart-badge').textContent = '0'
            })
    }

    if (decreaseBtn) {
        decreaseBtn.addEventListener('click', function () {
            const current = parseInt(quantityInput.value)
            if (current > 1) {
                quantityInput.value = current - 1
            }
        })
    }

    if (increaseBtn) {
        increaseBtn.addEventListener('click', function () {
            const current = parseInt(quantityInput.value)
            if (current < maxStock) {
                quantityInput.value = current + 1
            }
        })
    }

    if (addToCartBtn) {
        addToCartBtn.addEventListener('click', function () {
            const quantity = parseInt(quantityInput.value)

            ensureCart(function (cartId) {
                if (productInCart) {
                    fetch('/api/carts/' + cartId + '/products/' + productId, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ quantity: quantity })
                    }).then(function () {
                        updateCartBadge()
                        alert('Carrito actualizado')
                    })
                } else {
                    fetch('/api/carts/' + cartId + '/product/' + productId, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ quantity: quantity })
                    }).then(function () {
                        updateCartBadge()
                        alert('Producto agregado al carrito')
                    })
                }
            })
        })
    }

    // Crear carrito al cargar la página si no existe
    ensureCart(function (cartId) {
        updateCartBadge()
    })
</script>

