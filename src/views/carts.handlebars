{{!-- src/views/carts.handlebars --}}

{{!-- Navbar --}}
<nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top shadow">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="/">
            <i class="bi bi-shop"></i> E-Commerce Backend
        </a>
        <div class="navbar-nav ms-auto">
            <a class="nav-link" href="/">Inicio</a>
            <a class="nav-link" href="/products">Productos</a>
            <a class="nav-link position-relative active" href="#" id="cart-link">
                <i class="bi bi-cart3"></i> Mi Carrito
                <span class="badge bg-danger rounded-pill position-absolute top-0 start-100 translate-middle"
                    id="cart-badge">
                    0
                </span>
            </a>
        </div>
    </div>
</nav>

{{!-- Header Principal --}}
<div class="bg-gradient-primary text-white py-5 mb-4">
    <div class="container-fluid text-center px-0">
        <h1 class="display-4 fw-bold mb-2">
            <i class="bi bi-cart-check-fill"></i> Mi Carrito
        </h1>
        <p class="lead mb-0">Revisa y gestiona tus productos seleccionados</p>
    </div>
</div>

{{!-- Breadcrumb --}}
<div class="container-fluid mb-4 px-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb justify-content-center mb-0">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Mi Carrito</li>
        </ol>
    </nav>
</div>

{{!-- Contenido del Carrito --}}
<div class="container-fluid mb-5 px-4">
    {{#if cart.products}}
    {{#if (gt cart.products.length 0)}}
    <div class="row">
        {{!-- Productos del Carrito --}}
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-bag-fill"></i> Productos en el Carrito</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-center">Precio</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-center">Subtotal</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each cart.products}}
                                <tr id="product-row-{{this.product._id}}">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            {{#if this.product.thumbnails.[0]}}
                                            <img src="{{this.product.thumbnails.[0]}}" alt="{{this.product.title}}"
                                                class="img-thumbnail me-3"
                                                style="width: 80px; height: 80px; object-fit: cover;">
                                            {{else}}
                                            <div class="bg-secondary me-3 d-flex align-items-center justify-content-center"
                                                style="width: 80px; height: 80px;">
                                                <i class="bi bi-image text-white fs-3"></i>
                                            </div>
                                            {{/if}}
                                            <div>
                                                <h6 class="mb-1 fw-bold">{{this.product.title}}</h6>
                                                <small class="text-muted">{{this.product.category}}</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center align-middle">
                                        <span class="fw-bold text-success">${{this.product.price}}</span>
                                    </td>
                                    <td class="text-center align-middle">
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-sm decrease-qty-btn" data-id="{{this.product._id}}"
                                                data-quantity="{{this.quantity}}">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                            <span
                                                class="btn btn-sm btn-outline-secondary disabled qty-display-{{this.product._id}}"
                                                style="min-width: 50px;">
                                                {{this.quantity}}
                                            </span>
                                            <button class="btn btn-sm increase-qty-btn" data-id="{{this.product._id}}"
                                                data-quantity="{{this.quantity}}" data-stock="{{this.product.stock}}">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td class="text-center align-middle">
                                        <span class="fw-bold text-primary subtotal-{{this.product._id}}">
                                            ${{multiply this.product.price this.quantity}}
                                        </span>
                                    </td>
                                    <td class="text-center align-middle">
                                        <button class="btn btn-sm btn-danger remove-btn" data-id="{{this.product._id}}">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        {{!-- Resumen del Carrito --}}
        <div class="col-lg-4">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Resumen del Pedido</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Productos:</span>
                        <span id="total-items" class="fw-bold">{{cart.products.length}}</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Cantidad Total:</span>
                        <span id="total-quantity" class="fw-bold">
                            {{#each cart.products}}
                            {{#if @first}}{{this.quantity}}{{else}}{{/if}}
                            {{/each}}
                            {{#each cart.products}}
                            {{#unless @first}}+ {{this.quantity}}{{/unless}}
                            {{/each}}
                        </span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-3">
                        <h5>Total:</h5>
                        <h5 class="text-success" id="cart-total">${{calculateTotal cart.products}}</h5>
                    </div>
                    <div class="d-grid gap-2">
                        <button class="btn btn-success btn-lg" id="checkout-btn">
                            Finalizar Compra <i class="bi bi-check"></i>
                        </button>
                        <a href="/products" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left"></i> Seguir Comprando
                        </a>
                        <button class="btn btn-outline-danger" id="clear-cart-btn">
                            <i class="bi bi-trash"></i> Vaciar Carrito
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{else}}
    {{!-- Carrito Vacío --}}
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm">
                <div class="card-body py-5">
                    <i class="bi bi-cart-x display-1 text-muted mb-3"></i>
                    <h3 class="mb-3">Tu carrito está vacío</h3>
                    <p class="text-muted mb-4">¡Agrega productos a tu carrito para comenzar a comprar!</p>
                    <a href="/products" class="btn btn-primary btn-lg">
                        <i class="bi bi-shop"></i> Ir a Comprar
                    </a>
                </div>
            </div>
        </div>
    </div>
    {{/if}}
    {{else}}
    {{!-- Carrito Vacío (alternativa) --}}
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm">
                <div class="card-body py-5">
                    <i class="bi bi-cart-x display-1 text-muted mb-3"></i>
                    <h3 class="mb-3">Tu carrito está vacío</h3>
                    <p class="text-muted mb-4">¡Agrega productos a tu carrito para comenzar a comprar!</p>
                    <a href="/products" class="btn btn-primary btn-lg">
                        <i class="bi bi-shop"></i> Ir a Comprar
                    </a>
                </div>
            </div>
        </div>
    </div>
    {{/if}}
</div>

{{!-- JavaScript --}}
<script>
    const cartId = '{{cartId}}';

    // Actualizar el enlace del carrito
    function updateCartLink() {
        const cartLink = document.getElementById('cart-link');
        if (cartId) {
            cartLink.href = '/carts/' + cartId;
        }
    }

    // Actualizar badge del carrito
    function updateCartBadge() {
        if (!cartId) return

        fetch('/api/carts/' + cartId)
            .then(function (response) {
                if (!response.ok) {
                    throw new Error('Carrito no encontrado')
                }
                return response.json()
            })
            .then(function (cart) {
                if (cart.error || cart.status === 'error') {
                    throw new Error('Error al obtener carrito')
                }
                let total = 0
                for (let i = 0; i < cart.products.length; i++) {
                    total = total + cart.products[i].quantity
                }
                document.getElementById('cart-badge').textContent = total
            })
            .catch(function (error) {
                console.error('Error:', error)
                document.getElementById('cart-badge').textContent = '0'
            })
    }

    // Calcular totales
    function calculateTotals() {
        if (!cartId) return

        fetch('/api/carts/' + cartId)
            .then(function (response) {
                if (!response.ok) {
                    throw new Error('Carrito no encontrado')
                }
                return response.json()
            })
            .then(function (cart) {
                if (cart.error || cart.status === 'error') {
                    throw new Error('Error al obtener carrito')
                }
                const totalItems = cart.products.length
                let totalQuantity = 0
                let totalPrice = 0

                for (let i = 0; i < cart.products.length; i++) {
                    const item = cart.products[i]
                    totalQuantity += item.quantity
                    totalPrice += item.product.price * item.quantity
                }

                const totalItemsEl = document.getElementById('total-items')
                const totalQuantityEl = document.getElementById('total-quantity')
                const cartTotalEl = document.getElementById('cart-total')

                if (totalItemsEl) totalItemsEl.textContent = totalItems
                if (totalQuantityEl) totalQuantityEl.textContent = totalQuantity
                if (cartTotalEl) cartTotalEl.textContent = '$' + totalPrice.toFixed(2)
            })
            .catch(function (error) {
                console.error('Error:', error)
            })
    }

    // Aumentar cantidad
    const increaseButtons = document.querySelectorAll('.increase-qty-btn')
    for (let i = 0; i < increaseButtons.length; i++) {
        increaseButtons[i].addEventListener('click', function () {
            const productId = this.dataset.id
            const currentQty = parseInt(this.dataset.quantity)
            const stock = parseInt(this.dataset.stock)

            if (currentQty >= stock) {
                alert('No hay más stock disponible')
                return
            }

            fetch('/api/carts/' + cartId + '/products/' + productId, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ quantity: currentQty + 1 })
            }).then(function () {
                location.reload()
            })
        })
    }

    // Disminuir cantidad
    const decreaseButtons = document.querySelectorAll('.decrease-qty-btn')
    for (let i = 0; i < decreaseButtons.length; i++) {
        decreaseButtons[i].addEventListener('click', function () {
            const productId = this.dataset.id
            const currentQty = parseInt(this.dataset.quantity)

            if (currentQty <= 1) {
                if (confirm('¿Deseas eliminar este producto del carrito?')) {
                    fetch('/api/carts/' + cartId + '/products/' + productId, {
                        method: 'DELETE'
                    }).then(function () {
                        location.reload()
                    })
                }
            } else {
                fetch('/api/carts/' + cartId + '/products/' + productId, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ quantity: currentQty - 1 })
                }).then(function () {
                    location.reload()
                })
            }
        })
    }

    // Eliminar producto
    const removeButtons = document.querySelectorAll('.remove-btn')
    for (let i = 0; i < removeButtons.length; i++) {
        removeButtons[i].addEventListener('click', function () {
            const productId = this.dataset.id

            if (confirm('¿Estás seguro de que deseas eliminar este producto del carrito?')) {
                fetch('/api/carts/' + cartId + '/products/' + productId, {
                    method: 'DELETE'
                }).then(function () {
                    location.reload()
                })
            }
        })
    }

    // Vaciar carrito
    const clearCartBtn = document.getElementById('clear-cart-btn')
    if (clearCartBtn) {
        clearCartBtn.addEventListener('click', function () {
            if (confirm('¿Estás seguro de que deseas vaciar todo el carrito?')) {
                fetch('/api/carts/' + cartId, {
                    method: 'DELETE'
                }).then(function () {
                    location.reload()
                })
            }
        })
    }

    // Finalizar compra
    const checkoutBtn = document.getElementById('checkout-btn')
    if (checkoutBtn) {
        checkoutBtn.addEventListener('click', function () {
            if (confirm('¿Deseas finalizar la compra?')) {
                fetch('/api/carts/' + cartId + '/checkout', {
                    method: 'POST'
                })
                .then(function (response) { return response.json() })
                .then(function (data) {
                    if (data.mensaje) {
                        alert('¡Compra finalizada con éxito! Tu pedido ha sido registrado.')
                        localStorage.setItem('cartId', data.nuevoCarrito._id)
                        window.location.href = '/products'
                    }
                })
                .catch(function (error) {
                    console.error('Error:', error)
                    alert('Error al finalizar la compra')
                })
            }
        })
    }

    updateCartBadge()
    updateCartLink()
    calculateTotals()
</script>

